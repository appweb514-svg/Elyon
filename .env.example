# Configuration de l'environnement Elyon — copier ce fichier vers .env et ajuster.

# PostgreSQL — identifiants et base
ELYON_POSTGRES_USER=elyon
ELYON_POSTGRES_PASSWORD=CHANGE_ME
ELYON_POSTGRES_DB=elyon

# URL de connexion applicative (utilisée par l'API et le worker)
ELYON_DATABASE_URL=postgresql://elyon:CHANGE_ME@db:5432/elyon

# Redis — broker Celery
ELYON_REDIS_URL=redis://redis:6379/0

# Chemin racine de stockage des médias
ELYON_STORAGE_ROOT=/var/lib/elyon/media

# URL publique de l'API, vue depuis le navigateur
NEXT_PUBLIC_API_URL=http://localhost:8000

# Générer les secrets avec: openssl rand -hex 32
