# Configuration de l'environnement Elyon — copier ce fichier vers .env et ajuster.

# PostgreSQL — identifiants et base
ELYON_POSTGRES_USER=elyon
ELYON_POSTGRES_PASSWORD=CHANGE_ME
ELYON_POSTGRES_DB=elyon

# URL de connexion applicative (utilisée par l'API et le worker)
ELYON_DATABASE_URL=postgresql://elyon:CHANGE_ME@db:5432/elyon

# Redis — broker Celery
ELYON_REDIS_URL=redis://redis:6379/0

# Chemin racine de stockage des médias
ELYON_STORAGE_ROOT=/var/lib/elyon/media

# Quotas de stockage (octets) — chaque utilisateur dispose d'un espace
# personnel isolé ; le superadmin ne peut pas accéder aux médias des autres.
ELYON_USER_QUOTA_BYTES=5368709120
ELYON_ORG_QUOTA_BYTES=21474836480

# Alertes « appareil hors ligne » par e-mail (SMTP) — vide = désactivé.
ELYON_ALERT_SMTP_HOST=
ELYON_ALERT_SMTP_PORT=587
ELYON_ALERT_SMTP_USER=
ELYON_ALERT_SMTP_PASSWORD=
ELYON_ALERT_SMTP_FROM=
ELYON_ALERT_SMTP_STARTTLS=true
ELYON_ALERT_SMTP_TO=

# Webhook d'urgence (alarme externe → « Afficher » sur un écran).
# Clé partagée (en-tête X-Trigger-Secret) — vide = désactivé.
ELYON_TRIGGER_SECRET=

# URL publique de l'API, vue depuis le navigateur
NEXT_PUBLIC_API_URL=http://localhost:8000

# URL de l'API vue depuis le conteneur web (proxy Next.js)
ELYON_API_URL=http://api:8000

# Désactive la page de login : session ouverte automatiquement (lab/démo).
# Session ouverte avec ces identifiants côté serveur.
ELYON_DISABLE_LOGIN=
ELYON_AUTO_LOGIN_EMAIL=
ELYON_AUTO_LOGIN_PASSWORD=

# URL des blobs dans les manifestes (vue depuis les players Docker)
ELYON_PUBLIC_BASE_URL=http://api:8000

# Générer les secrets avec: openssl rand -hex 32
ELYON_SESSION_SECRET=CHANGE_ME

# Lab Raspberry émulé (make lab) : linux/amd64 par défaut.
# Pour aarch64 (Pi 4/5) : installer binfmt puis make lab-arm.
# ELYON_PLAYER_PLATFORM=linux/arm64
